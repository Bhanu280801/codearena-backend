PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://codearena:codearena@localhost:5432/codearena
REDIS_URL=redis://localhost:6379

# Set true on Linux workers with Docker available for sandboxed execution.
USE_DOCKER_SANDBOX=false

JS_DOCKER_IMAGE=node:22-alpine
PYTHON_DOCKER_IMAGE=python:3.12-alpine
CPP_DOCKER_IMAGE=gcc:14
JAVA_DOCKER_IMAGE=eclipse-temurin:21
